      "type": "stat",
      "title": "Stable 5xx ratio",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(student_app_http_requests_total{job=\"$job\", route!~\"sre-lab\\\\..*|up|health\\\\.ready|metrics\", status=~\"5..\"}[5m]) * on(instance) group_left(version, color) student_app_app_info{job=\"$job\", $by=\"$stable\"}) or vector(0)) / sum(rate(student_app_http_requests_total{job=\"$job\", route!~\"sre-lab\\\\..*|up|health\\\\.ready|metrics\"}[5m]) * on(instance) group_left(version, color) student_app_app_info{job=\"$job\", $by=\"$stable\"})",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
