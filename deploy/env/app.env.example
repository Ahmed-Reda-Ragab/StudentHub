# /opt/student-app/app.env on the EC2 host (chmod 600). Generated by the deploy scripts
# from SSM Parameter Store (/student-app/lab/*) — this file is only a template.
APP_NAME="Students Subscriptions"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_ME_php_artisan_key_generate_show
APP_URL=http://CHANGE_ME_PUBLIC_DNS
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=student_app
DB_USERNAME=student
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_LEVEL=info

# SRE lab switches (config/sre_lab.php). Keep SRE_LAB_TOKEN set on anything reachable from the internet.
SRE_LAB_ENABLED=true
SRE_LAB_TOKEN=CHANGE_ME
METRICS_ENABLED=true
SRE_FAULT_ERROR_RATE=0
SRE_FAULT_LATENCY_MS=0
SRE_FAULT_UNHEALTHY=false
SRE_FAULT_BOOT_FAIL=false
