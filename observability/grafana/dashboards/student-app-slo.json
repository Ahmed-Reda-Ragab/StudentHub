        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - job:student_app_sli_availability_errors:ratio_rate30d{job=\"$job\"} / (1 - 0.995)",
          "range": false,
          "instant": true
